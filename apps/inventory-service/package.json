{
  "name": "@services-sandbox/inventory-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@services-sandbox/config": "workspace:*",
    "@services-sandbox/contracts": "workspace:*",
    "@services-sandbox/kafka": "workspace:*",
    "@services-sandbox/telemetry": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.22.4"
  }
}
