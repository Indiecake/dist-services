{
  "name": "services-sandbox",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo foundation for the distributed services sandbox.",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node tests/run-all.ts",
    "test:config": "node --test packages/config/test/*.test.ts",
    "test:contracts": "node --test packages/contracts/test/*.test.ts",
    "test:telemetry": "node --test packages/telemetry/test/*.test.ts",
    "test:kafka": "node --test packages/kafka/test/*.test.ts",
    "test:checks": "node --test tests/checks/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
